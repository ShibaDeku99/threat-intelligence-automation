# Threat Intelligence API Credentials (copy to .env and fill in your keys)
# AlienVault OTX: https://otx.alienvault.com/api
OTX_API_KEY=

# URLhaus Community API Auth-Key: https://urlhaus.abuse.ch/api/
URLHAUS_AUTH_KEY=

# Storage & Cache Settings
DATABASE_PATH=data/threat_intel.db
REPORTS_DIR=reports
MITRE_DATA_DIR=data/mitre
CACHE_TTL_HOURS=24

# HTTP Client & Retry Settings
HTTP_CONNECT_TIMEOUT=5.0
HTTP_READ_TIMEOUT=15.0
HTTP_MAX_RETRIES=2
HTTP_BACKOFF_SECONDS=1.0

# Application Settings
LOG_LEVEL=INFO
DEFAULT_DEFANG_EXPORTS=true

