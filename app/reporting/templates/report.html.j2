<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  <style>
    :root {
      --bg: #f8fafc;
      --card: #ffffff;
      --text: #0f172a;
      --muted: #475569;
      --border: #e2e8f0;
      --critical: #dc2626;
      --high: #ea580c;
      --medium: #ca8a04;
      --low: #16a34a;
      --accent: #1d4ed8;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      padding: 24px;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.5;
    }
    .container { max-width: 1120px; margin: 0 auto; }
    header {
      background: #0f172a;
      color: #f8fafc;
      padding: 24px 28px;
      border-radius: 12px;
      margin-bottom: 24px;
    }
    header h1 { margin: 0 0 6px; font-size: 1.5rem; }
    header .meta { font-size: 0.88rem; color: #cbd5e1; }
    .disclaimer {
      background: #eff6ff;
      border-left: 4px solid var(--accent);
      padding: 12px 16px;
      border-radius: 6px;
      font-size: 0.9rem;
      margin-bottom: 24px;
      color: #1e3a8a;
    }
    .report-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 22px 24px;
      margin-bottom: 22px;
      box-shadow: 0 1px 3px rgba(15, 23, 42, 0.05);
    }
    .card-header {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      border-bottom: 1px solid var(--border);
      padding-bottom: 14px;
      margin-bottom: 16px;
    }
    .ioc-value {
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      font-size: 1.15rem;
      font-weight: 700;
      word-break: break-all;
    }
    .badges { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
    .badge {
      display: inline-block;
      padding: 4px 10px;
      border-radius: 999px;
      font-size: 0.8rem;
      font-weight: 600;
      color: #ffffff;
    }
    .badge-Critical { background: var(--critical); }
    .badge-High { background: var(--high); }
    .badge-Medium { background: var(--medium); }
    .badge-Low { background: var(--low); }
    .badge-neutral { background: #334155; }
    .badge-warn { background: #7c3aed; }
    .kpi-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
      gap: 12px;
      margin-bottom: 16px;
    }
    .kpi {
      background: #f8fafc;
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 10px 12px;
    }
    .kpi .label { font-size: 0.78rem; color: var(--muted); text-transform: uppercase; }
    .kpi .val { font-size: 1.1rem; font-weight: 700; margin-top: 2px; }
    h3 { font-size: 1rem; margin: 18px 0 8px; color: #1e293b; }
    p.summary { margin: 0 0 12px; color: #1e293b; }
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.88rem;
      margin-bottom: 12px;
    }
    th, td {
      text-align: left;
      padding: 8px 10px;
      border-bottom: 1px solid var(--border);
      vertical-align: top;
    }
    th { background: #f1f5f9; font-weight: 600; color: #334155; }
    .bar-track {
      width: 100%;
      height: 8px;
      background: #e2e8f0;
      border-radius: 999px;
      overflow: hidden;
    }
    .bar-fill { height: 100%; background: var(--accent); }
    ul.actions { margin: 6px 0 0; padding-left: 20px; }
    ul.actions li { margin-bottom: 6px; }
    .muted { color: var(--muted); font-size: 0.85rem; }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <h1>{{ title }}</h1>
      <div class="meta">
        Generated (UTC): {{ generated_at }} &middot; Indicators Analyzed: {{ reports | length }}
        &middot; IOC Display Mode: {{ "Defanged (Safe)" if defanged else "Raw" }}
      </div>
    </header>

    <div class="disclaimer">
      <strong>Analytical Notice:</strong> Heuristic Risk Score is an internal decision-support rubric (0&ndash;100), not an international standard. Risk Score and Confidence Score are intentionally separated; analysts must verify findings before applying blocking controls.
    </div>

    {% for item in reports %}
    <section class="report-card">
      <div class="card-header">
        <div>
          <div class="ioc-value">{{ item.display_ioc }}</div>
          <div class="muted">
            Type: {{ item.ioc_type }} &middot;
            Source First Seen: {{ item.source_first_seen }} &middot;
            Source Last Seen: {{ item.source_last_seen }} &middot;
            Report Generated: {{ item.generated_at }}
          </div>
        </div>
        <div class="badges">
          <span class="badge badge-{{ item.risk_level }}">{{ item.risk_level }} ({{ item.risk_score }}/100)</span>
          <span class="badge badge-neutral">{{ item.classification }}</span>
          <span class="badge badge-neutral">Confidence: {{ item.confidence_score }}/100</span>
          {% if item.is_reserved_ip %}
          <span class="badge badge-warn">Non-Routable / Reserved IP</span>
          {% endif %}
        </div>
      </div>

      <p class="summary">{{ item.summary }}</p>

      <div class="kpi-grid">
        <div class="kpi">
          <div class="label">Source Reliability</div>
          <div class="val">{{ item.breakdown.source_reliability }} / 40</div>
          <div class="bar-track"><div class="bar-fill" style="width: {{ (item.breakdown.source_reliability / 40 * 100) | round }}%;"></div></div>
        </div>
        <div class="kpi">
          <div class="label">Independent Sources</div>
          <div class="val">{{ item.breakdown.independent_sources }} / 25</div>
          <div class="bar-track"><div class="bar-fill" style="width: {{ (item.breakdown.independent_sources / 25 * 100) | round }}%;"></div></div>
        </div>
        <div class="kpi">
          <div class="label">Recency</div>
          <div class="val">{{ item.breakdown.recency }} / 20</div>
          <div class="bar-track"><div class="bar-fill" style="width: {{ (item.breakdown.recency / 20 * 100) | round }}%;"></div></div>
        </div>
        <div class="kpi">
          <div class="label">Activity Status</div>
          <div class="val">{{ item.breakdown.activity_status }} / 15</div>
          <div class="bar-track"><div class="bar-fill" style="width: {{ (item.breakdown.activity_status / 15 * 100) | round }}%;"></div></div>
        </div>
      </div>

      <h3>Threat Intelligence Evidence ({{ item.sources_with_evidence }} confirming / {{ item.sources_checked }} checked)</h3>
      {% if item.evidence %}
      <table>
        <thead>
          <tr>
            <th>Source</th>
            <th>Status</th>
            <th>Signal</th>
            <th>Context / Tags</th>
            <th>Source Last Seen</th>
            <th>Retrieved At (UTC)</th>
            <th>Latency</th>
          </tr>
        </thead>
        <tbody>
          {% for ev in item.evidence %}
          <tr>
            <td>{{ ev.source_name }}</td>
            <td>{{ ev.status }}{% if ev.from_cache %} (cached){% endif %}</td>
            <td>{{ "Malicious" if ev.is_malicious_signal else "None" }}</td>
            <td>
              {% if ev.error_message %}
                <span class="muted">{{ ev.error_message }}</span>
              {% else %}
                {{ ev.context_text }}
              {% endif %}
            </td>
            <td>{{ ev.source_last_seen }}</td>
            <td>{{ ev.retrieved_at }}</td>
            <td>{{ ev.latency_ms }} ms</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
      {% else %}
      <p class="muted">No source evidence records available.</p>
      {% endif %}

      <h3>MITRE ATT&amp;CK Mapping</h3>
      {% if item.techniques %}
      <table>
        <thead>
          <tr>
            <th>Technique ID</th>
            <th>Name</th>
            <th>Tactic</th>
            <th>Confidence</th>
            <th>Evidence</th>
          </tr>
        </thead>
        <tbody>
          {% for tech in item.techniques %}
          <tr>
            <td><strong>{{ tech.technique_id }}</strong></td>
            <td>{{ tech.name }}</td>
            <td>{{ tech.tactic }}</td>
            <td>{{ tech.confidence }}</td>
            <td>{{ tech.evidence }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
      {% else %}
      <p class="muted">No evidence-backed MITRE ATT&amp;CK techniques mapped.</p>
      {% endif %}

      <h3>Recommended Investigation Actions</h3>
      <ul class="actions">
        {% for action in item.recommended_actions %}
        <li>{{ action }}</li>
        {% endfor %}
      </ul>
    </section>
    {% endfor %}
  </div>
</body>
</html>

